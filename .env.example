# binance-public-data ETL configuration
# Copy this file to .env and fill in your actual values.

# ── PostgreSQL connection ──────────────────────────────────────────────────────
PGHOST=localhost

# Superuser credentials (used only for initial database/role creation)
PGSUPERUSER=postgres
PG_SUPERUSER_PASSWORD=Postgres@123456
PGSUPERDB=postgres

# Application role credentials (used for all data read/write)
APP_DB_USER=local_write
APP_DB_PASSWORD=Abc@123456

# ── ETL tuning ────────────────────────────────────────────────────────────────
# Number of parallel worker threads (default: min(12, cpu_count))
# KLINE_WORKERS=8

# Set to 1 to skip zip checksum verification (faster, less safe)
# KLINE_SKIP_CHECKSUM=0
